# Secrets — never commit
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs / uv
.venv/
venv/

# Local data: private by default. Only data/sample_data/ is tracked (the bundled example
# CSV); everything else under data/ — real broker exports in my_data/, the price cache in
# prices/ — stays local. The curated discovery universe lives INSIDE the package
# (app/data/universe.csv) so installed runs (uvx / pip / .mcpb) get it from the wheel.
data/*
!data/sample_data/
# Ghostfolio's own AGPL-3.0 test fixtures — kept locally for reference/validation only;
# NOT ours to redistribute under this repo's license. Our tests use self-made fixtures.
data/sample_data/sample.csv
data/sample_data/sample.json
data/sample_data/500-activities.json
# Malformed CSVs for the manual D1 import-safety check (recreatable per docs/testing/
# manual-test-plan-v2.8.1.md); the automated tests build their own malformed rows.
data/sample_data/mal*.csv
# Anchored: a bare `reports/` matches a directory of that name at ANY depth, which silently
# swallowed `docs/reports/` too — every point-in-time review in there was untracked in the
# private backup for weeks while the CHANGELOG linked to them. Only the generated briefs at
# the repo root are meant to be ignored.
/reports/
*.sqlite
*.db
t.csv

# Generated reconciliation artifact (regenerated by to_ghostfolio_csv.py)
reconcile/ghostfolio/ghostfolio_import.csv
# One-off real Ghostfolio JSON exports (local reference; not a tracked fixture)
reconcile/ghostfolio/ghostfolio-export-*.json

# OS / editor noise
.DS_Store
*.swp
.vscode/
.idea/

dist/
