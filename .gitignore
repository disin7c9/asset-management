# Secrets — never commit
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs / uv
.venv/
venv/

# Local data: private by default. Only data/sample_data/ + data/universe.csv are tracked
# (the bundled example CSV + the curated discovery universe the CLI + tests use); everything
# else under data/ — real broker exports in my_data/, the price cache in prices/ — stays local.
data/*
!data/sample_data/
!data/universe.csv
# Ghostfolio's own AGPL-3.0 test fixtures — kept locally for reference/validation only;
# NOT ours to redistribute under this repo's license. Our tests use self-made fixtures.
data/sample_data/sample.csv
data/sample_data/sample.json
data/sample_data/500-activities.json
reports/
*.sqlite
*.db
t.csv

# Generated reconciliation artifact (regenerated by to_ghostfolio_csv.py)
reconcile/ghostfolio/ghostfolio_import.csv
# One-off real Ghostfolio JSON exports (local reference; not a tracked fixture)
reconcile/ghostfolio/ghostfolio-export-*.json

# OS / editor noise
.DS_Store
*.swp
.vscode/
.idea/

dist/
