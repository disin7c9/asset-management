# Secrets — never commit
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs / uv
.venv/
venv/

# Local data: private by default. Only data/sample_data/ is tracked (the bundled
# example CSV the CLI + tests use); everything else under data/ — real broker
# exports in my_data/, the price cache in prices/ — stays local-only.
data/*
!data/sample_data/
reports/
*.sqlite
*.db
t.csv

# Generated reconciliation artifact (regenerated by to_ghostfolio_csv.py)
reconcile/ghostfolio/ghostfolio_import.csv

# OS / editor noise
.DS_Store
*.swp
.vscode/
.idea/

